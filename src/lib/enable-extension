#!/usr/bin/env bash
set -uo pipefail

readonly UUID="pardus-yansit@pardus.org.tr"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/pardus-yansit"
readonly MARKER="$STATE_DIR/extension-enabled-v1"

[[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]] || exit 0
[[ -e "$MARKER" ]] && exit 0
command -v gnome-extensions >/dev/null 2>&1 || exit 0

mkdir -p "$STATE_DIR"

if gnome-extensions info "$UUID" >/dev/null 2>&1 && \
   gnome-extensions enable "$UUID" >/dev/null 2>&1; then
    : > "$MARKER"
fi

exit 0

